# Copia este archivo como .env y completa los valores (el .env no se sube a git).
# Vite solo expone al navegador las variables que empiezan con VITE_: todo lo que
# pongas aquí queda visible en el sitio publicado. Nunca pongas la llave secreta.

# local = servidor del restaurante (API REST + Socket.IO); nube = réplica en Supabase
VITE_MODO=local

# Modo local: URL del servidor del restaurante
VITE_API_URL=http://localhost:3000

# Modo nube: Supabase → Project Settings → API (URL) y API Keys → Publishable key (sb_publishable_...)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Modo local: API key de esta aplicación ante el servidor del restaurante (debe ser una de las
# de API_KEYS del .env del backend). Es visible en el navegador: identifica a la aplicación,
# no protege datos (eso lo hace el login). Sin valor aquí; pídesela a quien administra el servidor.
VITE_API_KEY=
